ANTHROPIC_API_KEY=sk-ant-...
ELEVENLABS_API_KEY=sk_...

# Optional overrides
# ANTHROPIC_MODEL=claude-sonnet-4-6
# ANTHROPIC_MAX_TOKENS=256
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# ELEVENLABS_OUTPUT_FORMAT=mp3_44100_64

# Speech to text. Default "auto" uses Groq when GROQ_API_KEY is set and local Whisper
# when it isn't. Groq is typically under a second against Whisper's 5-8, and skips the
# ~1.5 GB model download entirely.
# GROQ_API_KEY=gsk_...
# STT_PROVIDER=auto          # auto | groq | whisper
# GROQ_STT_MODEL=whisper-large-v3-turbo
# WHISPER_MODEL=distil-large-v3
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE=int8
# PORT=8082
# HOST=0.0.0.0

# Claude tools (#2). Web search is an Anthropic-hosted server tool (bills per
# search on your account); local tools are datetime + save/recall notes.
# GB_WEB_SEARCH=true
# GB_LOCAL_TOOLS=true
