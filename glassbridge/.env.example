ANTHROPIC_API_KEY=sk-ant-...
ELEVENLABS_API_KEY=sk_...

# Optional overrides
# ANTHROPIC_MODEL=claude-sonnet-4-6
# ANTHROPIC_MAX_TOKENS=256
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# ELEVENLABS_OUTPUT_FORMAT=mp3_44100_64
# WHISPER_MODEL=distil-large-v3
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE=int8
# PORT=8082
# HOST=0.0.0.0

# Claude tools (#2). Web search is an Anthropic-hosted server tool (bills per
# search on your account); local tools are datetime + save/recall notes.
# GB_WEB_SEARCH=true
# GB_LOCAL_TOOLS=true

# Claude Code voice control. "agent" runs Claude Code sessions in THIS backend
# via the Agent SDK (needs the `claude` CLI on PATH: npm i -g @anthropic-ai/claude-code).
# "remote" proxies code-session calls to another Glassbridge backend (e.g. your
# Mac over Tailscale/LAN) — point GB_REMOTE_BRIDGE_URL at it.
# GB_CODE_DRIVER=agent
# GB_REMOTE_BRIDGE_URL=http://your-mac.tailnet.ts.net:8082
# GB_CODE_MODEL=claude-sonnet-4-6
# GB_CODE_CWD=/path/to/your/repo        # working dir for agent sessions
# GB_CODE_PERMISSION_MODE=bypassPermissions   # voice can't approve tool calls
# GB_CODE_SPEAK_MAX_CHARS=700
